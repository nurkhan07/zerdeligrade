# ---------------------------------------------------------------------------
# ZerdeliGrade environment variables. Copy to .env.local and fill in.
# Never commit real values. Never prefix the service-role key with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for user invitations, OMR result writes and storage access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed app (used in invitation and password-reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Private storage bucket for answer-sheet photos (created by the migrations)
SUPABASE_STORAGE_BUCKET=answer-sheets

# Days to keep uploaded answer-sheet photos before the retention job deletes them
FILE_RETENTION_DAYS=365

# Shared secret for the retention cron endpoint (Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string
