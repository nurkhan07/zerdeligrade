{
  "name": "zerdeligrade",
  "version": "0.1.0",
  "private": true,
  "description": "ZerdeliGrade: assessment, answer-sheet generation and OMR checking platform for the Zerdeli network",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run tests/db",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "db:remove-demo": "node scripts/seed-demo.mjs --remove"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@pdf-lib/fontkit": "1.1.1",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-slot": "1.2.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsqr": "1.4.0",
    "lucide-react": "0.544.0",
    "next": "16.3.8",
    "papaparse": "5.5.3",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.62.0",
    "recharts": "3.2.1",
    "server-only": "0.0.1",
    "sharp": "0.34.4",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.10",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.6.2",
    "@types/papaparse": "5.3.16",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
